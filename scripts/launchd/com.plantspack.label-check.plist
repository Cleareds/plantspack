<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.plantspack.label-check</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/antonkravchuk/sidep/Cleareds/plantspack/scripts/_label-check-auto-batch.sh</string>
  </array>
  <!-- Every 15 min, 2 chunks (120 rows) per run; 20 chunks = ~10 runs. launchd never
       overlaps a job with itself. The script unloads this job when the queue is empty. -->
  <key>StartInterval</key>
  <integer>900</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/label-check.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/label-check.log</string>
</dict>
</plist>
